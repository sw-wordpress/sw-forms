#: src/WordPress/Fields/FileField.php:60
msgid "Allow multiple files"
msgstr "Mehrere Dateien erlauben"

#: src/WordPress/Fields/FileField.php:62
msgid ""
"Uploads require entry storage. Files have public, unguessable URLs until the "
"entry is permanently deleted."
msgstr ""
"Uploads benötigen die Eintragsspeicherung. Dateien haben öffentliche, nicht "
"erratbare URLs, bis der Eintrag endgültig gelöscht wird."

#: src/WordPress/Fields/FileField.php:68
msgid "Allowed file extensions"
msgstr "Erlaubte Dateiendungen"

#: src/WordPress/Fields/FileField.php:69
msgid ""
"Comma-separated: pdf, txt, csv, jpg, jpeg, png, gif, webp, zip. WordPress "
"restrictions also apply. Empty means no uploads allowed."
msgstr ""
"Kommagetrennt: pdf, txt, csv, jpg, jpeg, png, gif, webp, zip. WordPress-"
"Beschränkungen gelten zusätzlich. Leer bedeutet: keine Uploads erlaubt."

#: src/WordPress/Fields/FileField.php:76
msgid "Maximum size per file (MB)"
msgstr "Maximale Größe pro Datei (MB)"

#: src/WordPress/Fields/FileField.php:86
msgid "Maximum files"
msgstr "Maximale Dateianzahl"

#: src/WordPress/Fields/FileField.php:226
msgid ""
"Please finish recording or processing the selected file before submitting."
msgstr ""
"Bitte die Aufnahme oder Bearbeitung der ausgewählten Datei vor dem Absenden "
"abschließen."

#. translators: 1: number of files, 2: size, 3: file extensions
#: src/WordPress/Fields/FileField.php:232
#, php-format
msgid ""
"Choose or drop up to %1$d file(s), %2$s each. Allowed: %3$s. After a page "
"reload, select files again."
msgstr ""
"Bis zu %1$d Datei(en) auswählen oder ablegen, jeweils %2$s. Erlaubt: %3$s. "
"Nach dem Neuladen Dateien erneut auswählen."


#, php-format
msgid "SW Forms requires PHP %1$s or newer. You are running PHP %2$s."
msgstr "SW Forms benötigt PHP %1$s oder neuer. Installiert ist PHP %2$s."

#: sw-forms.php:56
msgid ""
"SW Forms: the vendor directory is missing. Install the release package or "
"run \"composer install\"."
msgstr ""
"SW Forms: Das vendor-Verzeichnis fehlt. Das Release-Paket installieren oder "
"„composer install“ ausführen."

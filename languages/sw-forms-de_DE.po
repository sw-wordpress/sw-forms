msgstr ""
"Der ganze Wert muss passen, z. B. [0-9]{5} für eine deutsche Postleitzahl."

#: src/WordPress/Fields/InputField.php:323
msgid "Message when the pattern does not match"
msgstr "Meldung, wenn das Muster nicht passt"

#: src/WordPress/Fields/InputField.php:331

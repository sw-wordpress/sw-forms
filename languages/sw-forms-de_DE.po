msgid "Cancel crop"
msgstr "Zuschnitt abbrechen"

#: src/WordPress/Fields/ImageField.php:122
msgid "The crop could not be applied. The selected file is unchanged."
msgstr ""
"Der Zuschnitt konnte nicht angewendet werden. Die ausgewählte Datei ist "
"unverändert."


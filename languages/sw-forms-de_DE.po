#: src/WordPress/Support/Messages.php:54
msgid "The form document is invalid."
msgstr "Das Formulardokument ist ungültig."

#: src/WordPress/Support/Messages.php:55
msgid "An element is invalid."
msgstr "Ein Element ist ungültig."

#: src/WordPress/Support/Messages.php:56
msgid "An element has an invalid id."

msgid ""
"Comma-separated: jpg, jpeg, png, gif, webp. SVG and non-image files are not "
"accepted."
msgstr ""
"Kommagetrennt: jpg, jpeg, png, gif, webp. SVG und andere Dateitypen werden "
"nicht akzeptiert."


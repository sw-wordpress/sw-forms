#. translators: %s: field key
#: src/WordPress/Support/Messages.php:61
#, php-format
msgid ""
"The field name \"%s\" is invalid. Use letters, digits and underscores; start "
"with a letter."
msgstr ""
"Der Feldname „%s“ ist ungültig. Buchstaben, Ziffern und Unterstriche "
"verwenden, beginnend mit einem Buchstaben."

#. translators: %s: field key
#: src/WordPress/Support/Messages.php:63
#, php-format
msgid "The field name \"%s\" is used twice at the same level."
msgstr "Der Feldname „%s“ wird auf derselben Ebene doppelt verwendet."

#: src/WordPress/Support/Messages.php:64
msgid "The label is invalid."
msgstr "Die Beschriftung ist ungültig."

#: src/WordPress/Support/Messages.php:65
msgid "The contents of this container are invalid."
msgstr "Der Inhalt dieses Containers ist ungültig."

#. translators: %d: maximum number of columns
#: src/WordPress/Support/Messages.php:67
#, php-format
msgid "A column layout needs between 1 and %d columns."
msgstr "Ein Spaltenlayout braucht zwischen 1 und %d Spalten."

#: src/WordPress/Support/Messages.php:68
msgid "Column widths must be between 1 and 12."
msgstr "Spaltenbreiten müssen zwischen 1 und 12 liegen."

#. translators: %d: maximum nesting depth
#: src/WordPress/Support/Messages.php:70
#, php-format
msgid "Elements may be nested at most %d levels deep."
msgstr "Elemente dürfen höchstens %d Ebenen tief verschachtelt sein."

#: src/WordPress/Support/Messages.php:71
msgid "The conditional logic is invalid."
msgstr "Die Bedingungslogik ist ungültig."

#: src/WordPress/Support/Messages.php:72
msgid "A condition is invalid."
msgstr "Eine Bedingung ist ungültig."

#: src/WordPress/Support/Messages.php:73
msgid "A condition uses an unknown comparison."
msgstr "Eine Bedingung verwendet einen unbekannten Vergleich."

#: src/WordPress/Support/Messages.php:74
msgid "A condition refers to a field that does not exist or has no value."
msgstr ""
"Eine Bedingung verweist auf ein Feld, das nicht existiert oder keinen Wert "
"hat."

#: src/WordPress/Support/Messages.php:75
msgid "A condition cannot refer to the element itself."
msgstr "Eine Bedingung kann nicht auf das Element selbst verweisen."

#: src/WordPress/Support/Messages.php:76
msgid ""
"A condition refers to a field inside a repeatable group. Only fields of the "
"same row or outside the group can be used."
msgstr ""
"Eine Bedingung verweist auf ein Feld in einer wiederholbaren Gruppe. "
"Verwendbar sind nur Felder derselben Zeile oder außerhalb der Gruppe."

#: src/WordPress/Support/Messages.php:77
msgid "Conditions depend on each other in a circle."
msgstr "Bedingungen hängen im Kreis voneinander ab."

#: src/WordPress/Support/Messages.php:78
msgid "The form contains an error."
msgstr "Das Formular enthält einen Fehler."


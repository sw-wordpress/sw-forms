{
  "name": "sw-forms-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SW Forms admin (Vue 3 + Quasar, no Quasar CLI) and frontend runtime",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && vite build --config vite.frontend.config.ts",
    "build:only": "vite build && vite build --config vite.frontend.config.ts",
    "build:frontend": "vite build --config vite.frontend.config.ts",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --reporter=default --reporter=json --outputFile=coverage/tests.json && node tools/coverage.mjs"
  },
  "dependencies": {
    "@quasar/extras": "^2.1.0",
    "pinia": "^4.1.0",
    "quasar": "^2.18.0",
    "sortablejs": "^1.15.6",
    "tom-select": "2.6.2",
    "vue": "^3.5.0",
    "vue-i18n": "^11.4.16",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.2.0",
    "@quasar/vite-plugin": "^2.0.2",
    "@types/node": "^22.20.5",
    "@types/sortablejs": "^1.15.8",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "playwright-core": "^1.64.1",
    "postcss": "^8.5.32",
    "prettier": "^3.5.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.0.0",
    "vue-tsc": "^3.0.0"
  }
}

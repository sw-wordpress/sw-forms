{
  "name": "sw-forms-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SW Forms admin (Vue 3 + Quasar, no Quasar CLI) and frontend runtime",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && vite build --config vite.frontend.config.ts",
    "build:only": "vite build && vite build --config vite.frontend.config.ts",
    "build:frontend": "vite build --config vite.frontend.config.ts",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@quasar/extras": "^1.17.0",
    "pinia": "^3.0.0",
    "quasar": "^2.18.0",
    "sortablejs": "^1.15.6",
    "vue": "^3.5.0",
    "vue-i18n": "^10.0.8",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@fontsource-variable/inter": "^5.2.0",
    "@quasar/vite-plugin": "1.9.0",
    "@types/node": "^18.19.130",
    "@types/sortablejs": "^1.15.8",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^16.0.0",
    "jsdom": "^24.1.3",
    "playwright-core": "^1.55.1",
    "postcss": "^8.5.0",
    "prettier": "^3.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.40.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0",
    "vue-eslint-parser": "^10.0.0",
    "vue-tsc": "^3.0.0"
  }
}

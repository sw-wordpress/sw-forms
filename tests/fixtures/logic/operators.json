{
  "description": "Operator semantics: case-insensitive trimmed comparison, lists match per item, numbers accept a decimal comma.",
  "cases": [
    { "op": "is", "value": "Ja", "target": "ja", "expected": true },
    { "op": "is", "value": "  ja ", "target": "ja", "expected": true },
    { "op": "is", "value": "jab", "target": "ja", "expected": false },
    { "op": "is", "value": ["a", "B"], "target": "b", "expected": true },
    { "op": "is", "value": [], "target": "b", "expected": false },
    { "op": "is", "value": true, "target": "1", "expected": true },
    { "op": "is", "value": "Äpfel", "target": "äpfel", "expected": true },
    { "op": "isnot", "value": "ja", "target": "nein", "expected": true },
    { "op": "isnot", "value": ["a", "b"], "target": "a", "expected": false },
    { "op": "isnot", "value": "", "target": "x", "expected": true },
    { "op": "contains", "value": "Hello World", "target": "WORLD", "expected": true },
    { "op": "contains", "value": "Hello", "target": "xyz", "expected": false },
    { "op": "contains", "value": ["red", "green"], "target": "ree", "expected": true },
    { "op": "contains", "value": "abc", "target": "", "expected": true },
    { "op": "gt", "value": "10", "target": "9", "expected": true },
    { "op": "gt", "value": "1,5", "target": "1.4", "expected": true },
    { "op": "gt", "value": "abc", "target": "1", "expected": false },
    { "op": "gt", "value": "", "target": "0", "expected": false },
    { "op": "gt", "value": ["5"], "target": "1", "expected": false },
    { "op": "lt", "value": "-2", "target": "0", "expected": true },
    { "op": "lt", "value": "3", "target": "3", "expected": false },
    { "op": "empty", "value": "", "target": "", "expected": true },
    { "op": "empty", "value": "  ", "target": "", "expected": true },
    { "op": "empty", "value": [], "target": "", "expected": true },
    { "op": "empty", "value": false, "target": "", "expected": true },
    { "op": "empty", "value": null, "target": "", "expected": true },
    { "op": "notempty", "value": ["x"], "target": "", "expected": true },
    { "op": "notempty", "value": "0", "target": "", "expected": true },
    { "op": "unknown", "value": "a", "target": "a", "expected": false }
  ]
}

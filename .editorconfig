root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[{src/WordPress/**.php,includes/**.php,sw-forms.php,uninstall.php}]
indent_style = tab

[*.{ts,vue,js,json,yml,yaml,css,scss}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
